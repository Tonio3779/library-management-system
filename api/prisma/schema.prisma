
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
enum Role {
  PATRON
  LIBRARIAN
}
model Book {
  id              Int     @id @default(autoincrement())
  title           String
  author          String
  publicationYear Int
  isAvailable     Boolean @default(true)

  genreId Int
  genre   Genre @relation(fields: [genreId], references: [id])
  reviews Review[]
}

model Genre {
  id    Int    @id @default(autoincrement())
  name  String @unique
  books Book[]
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  role Role @default(PATRON)
  createdAt DateTime @default(now())
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  bookId Int
  book   Book @relation(fields: [bookId], references: [id])
}
