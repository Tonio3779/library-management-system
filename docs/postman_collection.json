
{
  "info": {
    "_postman_id": "a71c8f20-9b14-4c6e-8d31-2f7c9a6b4e10",
    "name": "Library Management System API",
    "description": "Postman collection for testing the Library Management System API, including authentication, authorization, genres, books, filtering, search and pagination.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "patronToken",
      "value": ""
    },
    {
      "key": "librarianToken",
      "value": ""
    },
    {
      "key": "genreId",
      "value": "1"
    },
    {
      "key": "bookId",
      "value": "17"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Patron",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Patron\",\n  \"email\": \"newpatron@example.com\",\n  \"password\": \"PatronPass123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login Patron",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const response = pm.response.json();",
                  "  if (response.access_token) {",
                  "    pm.collectionVariables.set('patronToken', response.access_token);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patron@test.com\",\n  \"password\": \"PatronPass123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login Librarian",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const response = pm.response.json();",
                  "  if (response.access_token) {",
                  "    pm.collectionVariables.set('librarianToken', response.access_token);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"librarian@library.com\",\n  \"password\": \"{{librarianPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Genres",
      "item": [
        {
          "name": "Create Genre",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mystery\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/genres",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "genres"
              ]
            }
          }
        },
        {
          "name": "Get All Genres",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/genres",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "genres"
              ]
            }
          }
        },
        {
          "name": "Get Genre By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/genres/{{genreId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "genres",
                "{{genreId}}"
              ]
            }
          }
        },
        {
          "name": "Update Genre",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mystery and Thriller\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/genres/{{genreId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "genres",
                "{{genreId}}"
              ]
            }
          }
        },
        {
          "name": "Delete Genre",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/genres/{{genreId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "genres",
                "{{genreId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Create Book (Librarian Only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{librarianToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Sample Book\",\n  \"author\": \"Sample Author\",\n  \"isbn\": \"9780000000002\",\n  \"totalCopies\": 3,\n  \"genreId\": 1,\n  \"publicationYear\": 2024\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ]
            }
          }
        },
        {
          "name": "Get All Books",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ]
            }
          }
        },
        {
          "name": "Get Book By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "{{bookId}}"
              ]
            }
          }
        },
        {
          "name": "Filter Books By Genre",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books?genreId={{genreId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "genreId",
                  "value": "{{genreId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Search Books",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books?search=Gatsby",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "Gatsby"
                }
              ]
            }
          }
        },
        {
          "name": "Paginate Books",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Update Book (Librarian Only)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{librarianToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"totalCopies\": 8\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "{{bookId}}"
              ]
            }
          }
        },
        {
          "name": "Delete Book (Librarian Only)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{librarianToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "{{bookId}}"
              ]
            }
          }
        }
      ]
    }
  ]
}
